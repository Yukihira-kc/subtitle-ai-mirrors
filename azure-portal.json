{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string", "defaultValue": "japaneast",
      "metadata": {"description":"音声版専用の無料 App Service を作成するリージョン"}
    }
  },
  "variables": {
    "group": "[concat('rg-subtitle-ai-mirrors-', uniqueString(subscription().subscriptionId, 'subtitle-ai-mirrors'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups", "apiVersion": "2022-09-01",
      "name": "[variables('group')]", "location": "[parameters('location')]",
      "tags": {"application":"subtitle-ai-mirrors"}
    },
    {
      "type": "Microsoft.Resources/deployments", "apiVersion": "2022-09-01",
      "name": "install-subtitle-ai-mirrors", "resourceGroup": "[variables('group')]",
      "dependsOn":["[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('group'))]"],
      "properties": {
        "mode":"Incremental",
        "expressionEvaluationOptions":{"scope":"inner"},
        "template":{
          "$schema":"https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion":"1.0.0.0",
          "variables":{"app":"[concat('subtitle-ai-mirrors-', uniqueString(resourceGroup().id))]","plan":"asp-subtitle-ai-mirrors"},
          "resources":[
            {
              "type":"Microsoft.Web/serverfarms","apiVersion":"2023-12-01",
              "name":"[variables('plan')]","location":"[resourceGroup().location]","kind":"linux",
              "sku":{"name":"F1","tier":"Free","capacity":1},"properties":{"reserved":true}
            },
            {
              "type":"Microsoft.Web/sites","apiVersion":"2023-12-01",
              "name":"[variables('app')]","location":"[resourceGroup().location]","kind":"app,linux",
              "dependsOn":["[resourceId('Microsoft.Web/serverfarms',variables('plan'))]"],
              "properties":{
                "serverFarmId":"[resourceId('Microsoft.Web/serverfarms',variables('plan'))]",
                "httpsOnly":true,
                "siteConfig":{
                  "linuxFxVersion":"NODE|22-lts","appCommandLine":"node server.js","webSocketsEnabled":true,
                  "ftpsState":"Disabled","minTlsVersion":"1.2",
                  "appSettings":[
                    {"name":"SCM_DO_BUILD_DURING_DEPLOYMENT","value":"true"},
                    {"name":"ROOM_STORE_PATH","value":"/home/data/subtitle-ai-mirrors/rooms.json"}
                  ]
                }
              }
            },
            {
              "type":"Microsoft.Web/sites/sourcecontrols","apiVersion":"2023-12-01",
              "name":"[concat(variables('app'),'/web')]",
              "dependsOn":["[resourceId('Microsoft.Web/sites',variables('app'))]"],
              "properties":{"repoUrl":"https://github.com/Yukihira-kc/subtitle-ai-mirrors","branch":"main","isManualIntegration":true}
            }
          ],
          "outputs":{"siteUrl":{"type":"string","value":"[concat('https://',reference(resourceId('Microsoft.Web/sites',variables('app')),'2023-12-01').defaultHostName,'/rooms.html')]"}}
        }
      }
    }
  ],
  "outputs":{"siteUrl":{"type":"string","value":"[reference(extensionResourceId(subscriptionResourceId('Microsoft.Resources/resourceGroups',variables('group')),'Microsoft.Resources/deployments','install-subtitle-ai-mirrors'),'2022-09-01').outputs.siteUrl.value]"}}
}
